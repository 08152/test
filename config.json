
{
  "project": {
    "name": "BODYGUARD_AI",
    "version": "0.1.0",
    "language": "de"
  },
  "robot": {
    "height_m": 1.8,
    "body_type": "humanoid",
    "simulation_enabled": false,
    "hardware_enabled": false
  },
  "brain": {
    "implementation": "custom",
    "learning_enabled": false,
    "checkpoint_directory": "speicher/checkpoints"
  },
  "training": {
    "mode": "simulation",
    "automatic": false,
    "max_steps_per_run": 1000,
    "save_every_steps": 100
  },
  "safety": {
    "require_validation": true,
    "allow_real_motor_commands": false
  },
  "resources": {
    "max_memory_mb": 1024,
    "max_parallel_simulations": 1
  }
}
